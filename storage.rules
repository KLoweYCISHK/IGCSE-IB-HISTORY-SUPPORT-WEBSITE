rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
    }
    // Files attached to student submissions (10 MB limit). Teacher uploads go
    // through the "edit" Cloud Function into /uploads.
    match /submissions/{file} {
      allow create: if request.resource.size < 10 * 1024 * 1024;
    }
  }
}
